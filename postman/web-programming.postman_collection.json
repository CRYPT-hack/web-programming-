{
  "info": {
    "name": "Web Programming - Node Express MongoDB API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "email", "value": "shobhit@example.com" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created (or 400 if already registered)', () => pm.expect(pm.response.code).to.be.oneOf([201, 400]));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"shobhit\",\n  \"email\": \"{{email}}\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/users/register"
          }
        },
        {
          "name": "Login User",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('logged in message', () => pm.expect(pm.response.json().message).to.eql('User logged in'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/users/login"
          }
        },
        {
          "name": "Logout User",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/users/logout"
          }
        }
      ]
    },
    {
      "name": "Posts (CRUD)",
      "item": [
        {
          "name": "Create Post",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('postId', pm.response.json().post._id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"My first post\",\n  \"description\": \"Created from Postman\",\n  \"age\": 20\n}" },
            "url": "{{baseUrl}}/posts/create"
          }
        },
        {
          "name": "Get All Posts",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/posts/getPosts" }
        },
        {
          "name": "Get Post By Id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/posts/{{postId}}" }
        },
        {
          "name": "Update Post",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('name updated', () => pm.expect(pm.response.json().post.name).to.eql('Updated post'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated post\",\n  \"age\": 21\n}" },
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        },
        {
          "name": "Delete Post",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/posts/{{postId}}" }
        },
        {
          "name": "Get Deleted Post (expect 404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/posts/{{postId}}" }
        }
      ]
    }
  ]
}
